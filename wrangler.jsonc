{
  // Cloudflare Worker (static assets) for the ynw.app landing site.
  // Assets-only worker: no main script, dist/ is served as-is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ynw-site",
  "compatibility_date": "2025-11-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "ynw.app", "custom_domain": true }
  ]
}
