  viewBox="0 0 321 71"
  width="321"
  height="71"
  role="img"
  aria-label="YNW"
>
  <title>YNW</title>
  <g transform="scale(1.1094)">
    <rect x="0.5" y="0.5" width="63" height="63" rx="7.5" fill="#090b0f" stroke="#3d3637"></rect>
    <circle cx="9.0" cy="9.0" r="3.1" fill="#30151a"></circle><circle cx="18.2" cy="9.0" r="3.1" fill="#30151a"></circle><circle cx="27.4" cy="9.0" r="3.1" fill="#eab46c"></circle><circle cx="36.6" cy="9.0" r="3.1" fill="#eab46c"></circle><circle cx="45.8" cy="9.0" r="3.1" fill="#eab46c"></circle><circle cx="55.0" cy="9.0" r="3.1" fill="#30151a"></circle>
    <circle cx="9.0" cy="18.2" r="3.1" fill="#30151a"></circle><circle cx="18.2" cy="18.2" r="3.1" fill="#ec9141"></circle><circle cx="27.4" cy="18.2" r="3.1" fill="#ec9141"></circle><circle cx="36.6" cy="18.2" r="3.1" fill="#30151a"></circle><circle cx="45.8" cy="18.2" r="3.1" fill="#ec9141"></circle><circle cx="55.0" cy="18.2" r="3.1" fill="#ec9141"></circle>
