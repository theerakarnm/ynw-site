---
/**
 * YNW lockup: logo tile (dot-grid wave in brand colors) + white wordmark.
 * Ported 1:1 from the reference SVG. Accessible name "YNW" replaces the
 * reference's <img alt="YNW">.
 */
const { class: className } = Astro.props;
---

