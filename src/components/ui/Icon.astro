---
/**
 * Inline icon set (stroke = currentColor via .ynw-i). Decorative by default:
 * icons inside this page are always aria-hidden; add a label externally if needed.
 */
interface Props {
  name: "check" | "shield" | "database" | "file" | "globe" | "terminal" | "coffee";
  size?: "xs" | "sm" | "md";
  class?: string;
}

const paths: Record<Props["name"], string> = {
  check: '<path d="M20 6 9 17l-5-5"></path>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path>',
  file:
    '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path>',
  globe:
    '<circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path>',
  terminal:
    '<polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line>',
  coffee:
    '<path d="M10 2v2"></path><path d="M14 2v2"></path><path d="M6 2v2"></path><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path>',
};

const { name, size, class: className } = Astro.props;
const sizeCls = size ? ` ${size}` : "";
---

<svg class:list={["ynw-i", sizeCls, className]} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name]} />
