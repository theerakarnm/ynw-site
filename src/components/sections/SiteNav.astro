---
/**
 * Fixed top nav: YNW lockup + wishlist CTA. On the landing page the CTA is a
 * button that smooth-scrolls to the nearest wishlist form (motion.ts / main.ts);
 * elsewhere it links home.
 */
import LogoLockup from "@/components/ui/LogoLockup.astro";
import { nav } from "@/data/content";

interface Props {
  /** True on the landing page (CTA jumps to the on-page form). */
  home?: boolean;
}

const { home = false } = Astro.props;
---

<nav class="ynw-nav site-nav" aria-label="Main">
  <a class="site-lockup-link" href="/" aria-label="YNW home">
    <LogoLockup />
  </a>
  <div class="ynw-nav-end">
    {
      home ? (
        <button class="ynw-btn ynw-btn--secondary" type="button" data-cta="jump-to-form">
          {nav.cta}
        </button>
      ) : (
        <a class="ynw-btn ynw-btn--secondary" href="/#top" data-cta="jump-to-form">
          {nav.cta}
        </a>
      )
    }
  </div>
</nav>
