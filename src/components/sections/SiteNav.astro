---
/**
 * Fixed top nav: YNW lockup + wishlist CTA. On the landing page the CTA is a
 * button that smooth-scrolls to the nearest wishlist form (motion.ts / main.ts);
 * elsewhere it links home. On /support the nav also shows the reference's
 * in-page anchors and a Buy Me a Coffee CTA.
 */
import LogoLockup from "@/components/ui/LogoLockup.astro";
import { copyOf, pageLocale } from "@/lib/page-copy";
import { localizePath } from "@/lib/locale";
import { donateUrl } from "@/data/site";

const locale = pageLocale(Astro.url);
const { nav, a11y } = copyOf(Astro.url);

interface Props {
  /** True on the landing page (CTA jumps to the on-page form). */
  home?: boolean;
  /** True on /support (anchors + BMC CTA instead of the wishlist jump). */
  support?: boolean;
}

const { home = false, support = false } = Astro.props;

const target = locale === "th" ? "en" : "th";
const { names, labels, switchToLabel, currentLabel } = a11y.language;
const switchName = `${switchToLabel.replace("{language}", names[target])}. ${currentLabel.replace("{language}", names[locale])}`;
---

<nav class="ynw-nav site-nav" aria-label={a11y.navLabel}>
  <a class="site-lockup-link" href={localizePath("/", locale)} aria-label={a11y.homeLabel}>
    <LogoLockup />
  </a>
  {
    support && (
      <div class="ynw-nav-links">
        {nav.supportLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    )
  }
  <div class="ynw-nav-end">
    <a
      class:list={["ynw-btn", "ynw-btn--secondary", { "ynw-btn--sm": support }]}
      href={localizePath(Astro.url.pathname, target)}
      hreflang={target}
      lang={target}
      aria-label={switchName}
      data-locale-switch={target}
    >
      {labels[target]}
    </a>
    {
      support ? (
        <a
          class="ynw-btn ynw-btn--secondary ynw-btn--sm"
          href={donateUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="bmc"
          data-cta-id="nav_bmc"
        >
          {nav.supportCta}
        </a>
      ) : home ? (
        <button class="ynw-btn ynw-btn--secondary" type="button" data-cta="jump-to-form" data-cta-id="nav_wishlist">
          {nav.cta}
        </button>
      ) : (
        <a class="ynw-btn ynw-btn--secondary" href={`${localizePath("/", locale)}#top`} data-cta="jump-to-form" data-cta-id="nav_wishlist">
          {nav.cta}
        </a>
      )
    }
  </div>
</nav>
