---
/**
 * Scene 06 - Agent relay: two separate chat windows, a PDF that flies from one to the other,
 * and the receipt printed below with the Actor line highlighted. The flight path is drawn at
 * run time from the measured windows (scripts/scenes/relay.ts), so the markup holds only the
 * final state: the file is already posted and the receipt is whole.
 */
import Scene from "./Scene.astro";
import { scenes, relayDemo as d } from "@/data/content";

const meta = scenes[5];
---

<Scene {...meta} stageClass="stage-relay">
  <div class="rl" role="group" aria-label={d.groupLabel}>
    <div class="rl-wins" data-beat="wins">
      <article class="win" data-beat="win-from">
        <header class="win-bar"><span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>{d.from}</header>
        <div class="rl-body">
          <div class="cmsg" data-beat="order">
            <span class="cmsg-av" aria-hidden="true">{d.order.initial}</span>
            <div class="cmsg-bubble" lang="th"><span class="cmsg-who">{d.order.who}</span>{d.order.text}</div>
          </div>
          <div class="cmsg cmsg--me" data-beat="ask">
            <div class="cmsg-bubble"><span class="mention">{d.mention}</span>{d.ask}</div>
          </div>
          <p class="rl-sys" data-beat="sys">{d.sys}</p>
        </div>
      </article>

      <article class="win win--to" data-beat="win-to">
        <header class="win-bar"><span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>{d.to}</header>
        <div class="rl-body">
          <div class="cmsg" data-beat="posted">
            <span class="cmsg-av" aria-hidden="true">{d.assistant.initial}</span>
            <div class="cmsg-bubble">
              <span class="cmsg-who">{d.assistant.who}</span>
              <span class="rl-file ynw-mono" data-beat="chip"><b>PDF</b>{d.file}</span>
              <span class="rl-delivered ynw-mono">{d.delivered}</span>
            </div>
          </div>
        </div>
      </article>

      <svg class="rl-trail" aria-hidden="true"><path data-beat="trail"></path></svg>
      <span class="rl-file rl-file--fly ynw-mono" data-beat="fly" aria-hidden="true"><b>PDF</b>{d.file}</span>
    </div>

    <section class="rl-receipt" data-beat="receipt" aria-label={d.receiptTitle}>
      <p class="rl-receipt-title ynw-mono">{d.receiptTitle}</p>
      <dl class="rl-rows ynw-mono">
        {
          d.receipt.map((row) => (
            <div class:list={["rl-row", { "is-actor": "actor" in row }]} data-beat={"actor" in row ? "actor" : undefined}>
              <dt>{row.key}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Scene>
