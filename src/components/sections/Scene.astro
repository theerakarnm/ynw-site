---
/**
 * Shared scene shell, three layouts, one markup. The copy column holds head, steps, receipt,
 * Replay and caption. copy-left / copy-right put it beside the stage; full lets CSS dissolve the
 * column so the head sits above the stage and the rest below it. No scene is pinned.
 * The markup is always the final state; motion.ts only animates it in.
 */
import SceneHead from "./SceneHead.astro";
import { sceneUi } from "@/data/content";

export interface SceneMeta {
  id: string;
  num: string;
  label: string;
  title: string;
  lead: string;
  caption?: string;
  stageClass?: string;
  steps?: readonly string[];
  /** Final-state receipt line, announced politely when it appears. */
  receipt?: string;
  /** Planned tag shown after the receipt (features that do not exist yet). */
  receiptTag?: string;
  /** Accessible label of the Replay button; shown by motion.ts on animated branches only. */
  replay?: string;
  /** Visible label of the button; default sceneUi.replay. */
  replayText?: string;
  /** Where the copy sits relative to the stage. Default full. */
  layout?: "full" | "copy-left" | "copy-right";
  closing?: boolean;
  /** Extra attributes on the section (a scene's own state, e.g. data-mode). */
  attrs?: Record<string, string>;
}

interface Props extends SceneMeta {}

const { id, num, label, title, lead, caption, stageClass, steps, receipt, receiptTag, replay, replayText = sceneUi.replay, layout = "full", closing = false, attrs = {} } = Astro.props;
const head = { id, num, label, title, lead };
---

<section
  class:list={["scene", `scene--${layout}`, { "scene--closing": closing }]}
  id={id}
  data-step={Number(num)}
  aria-labelledby={`h-${id}`}
  {...attrs}
>
  <div class="scene-grid">
    <div class="scene-body">
      <div class="scene-copy">
        <SceneHead {...head} />
        {steps && (
          <ol class="scene-steps">
            {steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        )}
        {receipt && (
          <p class="scene-receipt ynw-mono" aria-live="polite">
            {receipt}
            {receiptTag && <span class="ynw-badge ynw-badge--plain ynw-badge--accent">{receiptTag}</span>}
          </p>
        )}
        {replay && (
          <button class="ynw-btn ynw-btn--secondary ynw-btn--sm scene-replay" type="button" aria-label={replay} data-replay hidden>
            {replayText}
          </button>
        )}
        {caption && <p class="scene-caption ynw-mono">{caption}</p>}
      </div>
      <div class:list={["stage", stageClass]}>
        <slot />
      </div>
    </div>
  </div>
  <slot name="extra" />
</section>
