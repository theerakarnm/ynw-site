---
/**
 * Landing page. Composes the reference sections in order and adds the page
 * JSON-LD (SoftwareApplication) plus the boot script via the layout.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgressRail from "@/components/sections/ProgressRail.astro";
import Hero from "@/components/sections/Hero.astro";
import CapabilityTicker from "@/components/sections/CapabilityTicker.astro";
import SceneChat from "@/components/sections/SceneChat.astro";
import SceneAssistant from "@/components/sections/SceneAssistant.astro";
import SceneAccounts from "@/components/sections/SceneAccounts.astro";
import SceneApprovalModes from "@/components/sections/SceneApprovalModes.astro";
import SceneWorkflows from "@/components/sections/SceneWorkflows.astro";
import SceneRelay from "@/components/sections/SceneRelay.astro";
import SceneDevelopers from "@/components/sections/SceneDevelopers.astro";
import ScenePlanned from "@/components/sections/ScenePlanned.astro";
import SceneWishlist from "@/components/sections/SceneWishlist.astro";
import { site } from "@/data/site";
import { meta } from "@/data/content";

const softwareApp = {
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "CommunicationApplication",
  operatingSystem: "iOS, Android, Web, macOS, Windows, Linux",
  description: meta.home.description,
  url: site.url,
  offers: undefined, // pre-launch: no price, do not invent one
  publisher: { "@id": `${site.url}/#organization` },
};
---

<BaseLayout title={meta.home.title} description={meta.home.description} path="/" jsonLd={[softwareApp]}>
  <ProgressRail />
  <div id="run" class="run-anchor" tabindex="-1"></div>
  <Hero />
  <CapabilityTicker />
  <SceneChat />
  <SceneAssistant />
  <SceneAccounts />
  <SceneApprovalModes />
  <SceneWorkflows />
  <SceneRelay />
  <SceneDevelopers />
  <ScenePlanned />
  <SceneWishlist />
</BaseLayout>
