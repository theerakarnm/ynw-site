---
/**
 * 404. noindex. Keeps the reference's design language.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copyOf, pageLocale, localeStaticPaths } from "@/lib/page-copy";
import { localizePath } from "@/lib/locale";

export const getStaticPaths = localeStaticPaths;

const locale = pageLocale(Astro.url);
const { notFound: c, meta } = copyOf(Astro.url);

const title = meta.notFound.title;
---

<BaseLayout title={title} description={c.lead} path="/404" robots="noindex, follow">
  <div class="page-shell page-shell--narrow">
    <div class="page-eyebrow-row">
      <span class="ynw-eyebrow">{c.code}</span>
      <h1 class="page-title">{c.title}</h1>
      <p class="page-lead">{c.lead}</p>
    </div>
    <div class="profile-actions">
      <a class="ynw-btn ynw-btn--primary" href={localizePath("/", locale)}>{c.back} <span class="arrow">→</span></a>
    </div>
  </div>
</BaseLayout>
