---
/**
 * Unsubscribe confirmation. Reached from the worker's one-click unsubscribe
 * redirect. noindex.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copyOf, pageLocale, localeStaticPaths } from "@/lib/page-copy";
import { localizePath } from "@/lib/locale";

export const getStaticPaths = localeStaticPaths;

const locale = pageLocale(Astro.url);
const { unsubscribed: c, meta } = copyOf(Astro.url);

const title = meta.unsubscribed.title;
---

<BaseLayout title={title} description={c.lead} path="/unsubscribed/" robots="noindex, follow">
  <div class="page-shell page-shell--narrow">
    <div class="page-eyebrow-row">
      <span class="ynw-eyebrow">{c.eyebrow}</span>
      <h1 class="page-title">{c.title}</h1>
      <p class="page-lead">{c.lead}</p>
    </div>
    <div class="profile-actions">
      <a class="ynw-btn ynw-btn--secondary" href={localizePath("/", locale)}>{c.back}</a>
    </div>
  </div>
</BaseLayout>
