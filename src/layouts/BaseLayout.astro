---
/**
 * The only layout. Owns: head (SEO, JSON-LD, font preload), skip link, site nav,
 * main landmark and footer. Pages pass section content + per-page SEO/JSON-LD.
 */
import "@/styles/tokens.css";
import "@/styles/global.css";
import geistWoff2 from "@/assets/fonts/geist-latin-wght-normal.woff2?url";

import SEO from "@/components/seo/SEO.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import SiteNav from "@/components/sections/SiteNav.astro";
import SiteFooter from "@/components/sections/SiteFooter.astro";
import { site, absoluteUrl } from "@/data/site";
import { localizePath } from "@/lib/locale";
import { localeBootScript } from "@/lib/locale-boot";
import { copyOf, pageLocale } from "@/lib/page-copy";

export interface Props {
  title: string;
  description: string;
  /** Unprefixed (Thai) path of the page; localized URLs are derived from it. */
  path: string;
  robots?: string;
  /** Additional JSON-LD nodes for this page (WebPage is added automatically). */
  jsonLd?: Record<string, unknown>[];
  /** True on /support: nav shows the support anchors + Buy Me a Coffee CTA. */
  support?: boolean;
}

const { title, description, path, robots, jsonLd = [], support = false } = Astro.props;

const locale = pageLocale(Astro.url);
const { a11y, clientStrings, meta } = copyOf(Astro.url);
const pageUrl = absoluteUrl(localizePath(path, locale));

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: absoluteUrl("/icon-512.png"),
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: meta.home.description,
    inLanguage: locale,
    publisher: { "@id": `${site.url}/#organization` },
  },
  {
    "@type": "WebPage",
    "@id": pageUrl,
    url: pageUrl,
    name: title,
    description,
    inLanguage: locale,
    isPartOf: { "@id": `${site.url}/#website` },
  },
  ...jsonLd,
];

// "<" is escaped so no copy string can close the script element.
const clientJson = JSON.stringify(clientStrings).replace(/</g, "\\u003c");

const graphWithTypes = graph.map((node) => ({
  "@context": "https://schema.org",
  ...node,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Inline and first so a redirect happens before the stylesheet and fonts are requested. */}
    <script id="locale-boot" is:inline set:html={localeBootScript} />
    <SEO {title} {description} {path} {robots} {locale} imageAlt={meta.home.ogImageAlt} />
    <link rel="preload" href={geistWoff2} as="font" type="font/woff2" crossorigin />
    <JsonLd data={graphWithTypes} />
  </head>
  <body class="page" data-loop="run">
    <a class="skip" href="#main">{a11y.skipLink}</a>
    <SiteNav {support} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter {support} />
    <script id="i18n" type="application/json" set:html={clientJson} />
    <script>
      import "@/scripts/main";
    </script>
  </body>
</html>
