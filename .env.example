# Production values used by `npm run build` (copy to .env, which is gitignored).
# `npm run dev` uses .env.development instead (local worker + Turnstile test key).

# Canonical site origin (used for canonical URLs, sitemap, referral links).
PUBLIC_SITE_URL=https://ynw.app

# Marketing worker base URL. Empty = built-in mock API.
PUBLIC_API_BASE=https://api-marketing.ynw.app

# Cloudflare Turnstile site key (public; the secret lives on the worker only).
# REQUIRED in production builds - without it the worker will reject submissions.
PUBLIC_TURNSTILE_SITE_KEY=
