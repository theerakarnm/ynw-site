# Canonical site origin (used for canonical URLs, sitemap, referral links).
PUBLIC_SITE_URL=https://ynw.app

# Marketing worker base URL. Leave empty in dev to use the built-in mock API.
PUBLIC_API_BASE=

# Cloudflare Turnstile site key. Leave empty in dev: widget is skipped and the mock accepts an empty token.
# REQUIRED in production builds - without it the worker will reject submissions.
PUBLIC_TURNSTILE_SITE_KEY=
