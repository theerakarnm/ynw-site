# Dev-mode values (`npm run dev`); they override .env, which holds the production values.
# Committed on purpose: nothing here is secret.
# Run the marketing worker locally first: `npm run dev` in ../ynw-marketing-worker (http://localhost:8787).
# To use the built-in mock API instead, put `PUBLIC_API_BASE=` in .env.development.local.
PUBLIC_API_BASE=http://localhost:8787

# Cloudflare's published always-pass test site key. It pairs with the worker's dev
# TURNSTILE_SECRET (1x0000000000000000000000000000000AA in its .dev.vars.example).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
